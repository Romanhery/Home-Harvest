#include <Arduino.h>
#include <U8g2lib.h>
#include <Wire.h>
#include <Adafruit_NeoPixel.h>
#include <DHT.h>
#include <Preferences.h>

// ---- PIN DEFINITIONS ----
#define DHTPIN 27
#define DHTTYPE DHT22
#define SOIL_PIN 32
#define PUMP_PIN 18
#define LED_PIN 2
#define NUM_LEDS 10

// Joystick Pins
#define JOY_X 34
#define JOY_Y 35
#define JOY_BTN 33

// ---- OBJECT INIT ----
DHT dht(DHTPIN, DHTTYPE);
Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);
U8G2_SH1107_SEEED_128X128_F_HW_I2C u8g2(U8G2_R0, /* reset=*/ U8X8_PIN_NONE);
Preferences preferences; // For offline data saving

// ---- SENSOR & CONTROL VARIABLES ----
const int WET = 1600;
const int DRY = 3500;
int moisturePercent = 0;
float temp = 0.0;
int humi = 0;

unsigned long ledStartTime = 0;
bool ledsOn = true;

// ---- UI & SETTINGS VARIABLES ----
enum AppState { DASHBOARD, MENU, EDIT_VALUE };
AppState currentState = DASHBOARD;

// The Plant Database
const int NUM_PLANTS = 4;
String plantNames[NUM_PLANTS] = {"Tomato", "Basil", "Pothos", "Aloe Vera"};
int defaultThresholds[NUM_PLANTS] = {45, 40, 25, 10};

// Saved Settings
int currentPlantIdx = 0;
int userThreshold = 45;
int ledDurationHours = 12;

// Menu Tracking
int menuIndex = 0; 
const int NUM_MENU_ITEMS = 3;
String menuItems[NUM_MENU_ITEMS] = {"Plant Type", "LED Hours", "Water Thresh"};

// Joystick Debouncing
unsigned long lastJoyCheck = 0;
bool btnPressed = false;

// ---- FUNCTION PROTOTYPES ----
void colorWipe(uint32_t color, int wait);
void readSensors();
void controlHardware();
void handleJoystick();
void drawDashboard();
void drawMenu();

void setup() {
  Serial.begin(115200);

  // Pin Modes
  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);
  pinMode(JOY_BTN, INPUT_PULLUP);

  // Load Saved Settings from Offline Memory
  preferences.begin("harvest", false);
  currentPlantIdx = preferences.getInt("plantIdx", 0);
  userThreshold = preferences.getInt("thresh", defaultThresholds[currentPlantIdx]);
  ledDurationHours = preferences.getInt("ledHrs", 12);

  // Init Hardware
  dht.begin();
  strip.begin();
  strip.setBrightness(30);
  strip.show();
  
  u8g2.setBusClock(400000); 
  u8g2.begin();

  // Startup sequence
  colorWipe(strip.Color(0, 255, 0), 0);
  ledStartTime = millis();
}

void loop() {
  handleJoystick();
  readSensors();
  controlHardware();

  u8g2.clearBuffer();
  if (currentState == DASHBOARD) {
    drawDashboard();
  } else {
    drawMenu();
  }
  u8g2.sendBuffer();
}

// ---- HARDWARE CONTROL ----
void controlHardware() {
  // 1. LED Logic (Non-blocking)
  unsigned long durationMs = (unsigned long)ledDurationHours * 3600000; 
  unsigned long elapsed = millis() - ledStartTime;

  if (ledsOn && elapsed >= durationMs) {
    colorWipe(strip.Color(0, 0, 0), 0);
    ledsOn = false;
    ledStartTime = millis();
  } 
  else if (!ledsOn && elapsed >= (24UL * 3600000UL - durationMs)) { // Off for the rest of the 24h cycle
    colorWipe(strip.Color(0, 255, 0), 0);
    ledsOn = true;
    ledStartTime = millis();
  }

  // 2. Pump Logic (Continuous until restored)
  // We use +5 as a "Hysteresis" buffer so it doesn't stutter on and off rapidly
  if (moisturePercent < userThreshold) {
    digitalWrite(PUMP_PIN, HIGH);
  } else if (moisturePercent >= (userThreshold + 5)) {
    digitalWrite(PUMP_PIN, LOW);
  }
}

void readSensors() {
  // Only read every 2 seconds to avoid DHT lag
  static unsigned long lastRead = 0;
  if (millis() - lastRead > 2000) {
    lastRead = millis();
    int RAW = analogRead(SOIL_PIN);
    moisturePercent = constrain(map(RAW, DRY, WET, 0, 100), 0, 100);
    
    float t = dht.readTemperature();
    float h = dht.readHumidity();
    if (!isnan(t) && !isnan(h)) {
      temp = t;
      humi = (int)h;
    }
  }
}

// ---- JOYSTICK & UI LOGIC ----
void handleJoystick() {
  if (millis() - lastJoyCheck < 150) return; // Debounce speed
  
  int yVal = analogRead(JOY_Y);
  bool currentBtn = (digitalRead(JOY_BTN) == LOW);

  // Handle Button Clicks
  if (currentBtn && !btnPressed) {
    btnPressed = true;
    lastJoyCheck = millis();
    
    if (currentState == DASHBOARD) {
      currentState = MENU;
    } 
    else if (currentState == MENU) {
      currentState = EDIT_VALUE;
    } 
    else if (currentState == EDIT_VALUE) {
      currentState = MENU;
      // Save data to memory when exiting edit mode
      preferences.putInt("plantIdx", currentPlantIdx);
      preferences.putInt("thresh", userThreshold);
      preferences.putInt("ledHrs", ledDurationHours);
    }
  } else if (!currentBtn) {
    btnPressed = false;
  }

  // Handle Y-Axis Scrolling (Deadzone applied)
  if (yVal < 1000) { // Joystick UP
    lastJoyCheck = millis();
    if (currentState == MENU) {
      menuIndex = (menuIndex - 1 + NUM_MENU_ITEMS) % NUM_MENU_ITEMS;
    } else if (currentState == EDIT_VALUE) {
      if (menuIndex == 0) {
        currentPlantIdx = (currentPlantIdx - 1 + NUM_PLANTS) % NUM_PLANTS;
        userThreshold = defaultThresholds[currentPlantIdx]; // Auto-update threshold
      }
      else if (menuIndex == 1) ledDurationHours = min(24, ledDurationHours + 1);
      else if (menuIndex == 2) userThreshold = min(100, userThreshold + 5);
    }
  } 
  else if (yVal > 3000) { // Joystick DOWN
    lastJoyCheck = millis();
    if (currentState == MENU) {
      menuIndex = (menuIndex + 1) % NUM_MENU_ITEMS;
    } else if (currentState == EDIT_VALUE) {
      if (menuIndex == 0) {
        currentPlantIdx = (currentPlantIdx + 1) % NUM_PLANTS;
        userThreshold = defaultThresholds[currentPlantIdx]; // Auto-update threshold
      }
      else if (menuIndex == 1) ledDurationHours = max(1, ledDurationHours - 1);
      else if (menuIndex == 2) userThreshold = max(0, userThreshold - 5);
    }
  }
}

// ---- SCREEN DRAWING ----
void drawDashboard() {
  // Top Environment Section
  u8g2.setFont(u8g2_font_open_iconic_weather_4x_t);
  u8g2.drawGlyph(10, 45, 69); // Sun
  u8g2.setFont(u8g2_font_7x14_tr);
  u8g2.setCursor(55, 20);
  u8g2.print(temp, 1); u8g2.print(" C");
  u8g2.setCursor(55, 40);
  u8g2.print(humi); u8g2.print(" %H");

  u8g2.drawHLine(0, 60, 128);

  // Bottom Soil Section
  u8g2.setFont(u8g2_font_open_iconic_thing_4x_t);
  u8g2.drawGlyph(10, 110, 72); // Droplet
  u8g2.setFont(u8g2_font_logisoso32_tf); 
  u8g2.setCursor(55, 105);
  u8g2.print(moisturePercent); u8g2.print("%");
  
  u8g2.setFont(u8g2_font_5x8_tr);
  u8g2.setCursor(55, 120);
  u8g2.print(plantNames[currentPlantIdx]); // Show current plant
}

void drawMenu() {
  u8g2.setFont(u8g2_font_7x14_tr);
  u8g2.drawStr(10, 15, "--- SETTINGS ---");

  for (int i = 0; i < NUM_MENU_ITEMS; i++) {
    int yPos = 40 + (i * 25);
    
    // Highlight selected item
    if (i == menuIndex) {
      if (currentState == EDIT_VALUE) {
        u8g2.drawBox(5, yPos - 12, 118, 16); // Solid Box for editing
        u8g2.setDrawColor(0); // Draw text in black over white box
      } else {
        u8g2.drawFrame(5, yPos - 12, 118, 16); // Outline for browsing
      }
    }

    u8g2.setCursor(10, yPos);
    u8g2.print(menuItems[i]);
    u8g2.print(": ");

    // Print values based on the menu item
    if (i == 0) u8g2.print(plantNames[currentPlantIdx]);
    else if (i == 1) { u8g2.print(ledDurationHours); u8g2.print("h"); }
    else if (i == 2) { u8g2.print(userThreshold); u8g2.print("%"); }

    u8g2.setDrawColor(1); // Reset draw color to white
  }
}

void colorWipe(uint32_t color, int wait) {
  for (int i = 0; i < strip.numPixels(); i++) {
    strip.setPixelColor(i, color);
    strip.show();
    delay(wait);
  }
}
